{
  "name": "woodpresser-mcp",
  "version": "0.1.0",
  "description": "Structured, mode-gated WordPress access for AI agents. PHP, core WP, and Elementor in one MCP server.",
  "license": "MIT",
  "author": "Arman Saeedi",
  "type": "module",
  "bin": {
    "woodpresser": "dist/cli.js",
    "woodpresser-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "bridge",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/cli.js mcp",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:integration": "node tests/integration-playground.mjs",
    "bridge:zip": "node scripts/zip-bridge.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test && npm run verify:package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@wp-playground/cli": "^3.1.60",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wordpress",
    "elementor",
    "wpcode",
    "ai",
    "opencode",
    "claude",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-saeedia/woodpresser-mcp.git"
  },
  "homepage": "https://github.com/a-saeedia/woodpresser-mcp#readme",
  "bugs": {
    "url": "https://github.com/a-saeedia/woodpresser-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
